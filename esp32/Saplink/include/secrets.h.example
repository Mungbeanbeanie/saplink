// Copy to secrets.h and fill in. secrets.h is gitignored -- never commit it.
#pragma once

#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"

// Must match SAPLINK_TOKEN in /opt/saplink/.env on the saplink-api box.
#define SAPLINK_TOKEN "replace-me"
#define SAPLINK_URL "https://api.your-domain.example/api/readings"

// Base for alert routes (Phase 3+, CloudClient) -- no trailing slash.
// SAPLINK_URL above stays the full readings URL, unchanged.
#define SAPLINK_API_BASE "https://api.your-domain.example"

#define DEVICE_ID "sense-1"

// Contract B's node_id: which plant RAISED an event, not which one gets
// watered. 1 = plant 1, the origin, where the electrodes are. uint8_t on the
// wire, so 0-255.
#define NODE_ID 1
