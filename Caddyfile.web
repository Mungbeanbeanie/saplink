# saplink-web box. Serves app/frontend/ directly -- static HTML/CSS/JS, no build
# step (see compose.web.yaml).
{$SAPLINK_WEB_DOMAIN}, www.{$SAPLINK_WEB_DOMAIN} {
	root * /srv
	file_server
	# SPA fallback: unknown paths return index.html so client-side routing works.
	try_files {path} /index.html
}
